# Supabase — obligatoire en production pour conserver les données
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Protection du tableau de bord
ADMIN_PASSWORD=changez-ce-mot-de-passe
AUTH_SECRET=une-longue-chaine-aleatoire

# Démo locale : si Supabase n'est pas renseigné, l'application utilise un stockage mémoire.
